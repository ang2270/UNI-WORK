library(quantmod)
start_date <- "2015-12-01"
end_date   <- "2025-12-31"
getSymbols(tickers, src = "yahoo", from = start_date, to = end_date)
#========================================================
tickers <- c("VBK", "VB", "VBR",   # Small: growth, blend, value
"VOT", "VO", "VOE",   # Mid:   growth, blend, value
"VUG", "VV", "VTV")   # Large: growth, blend, value
#========================================================
getSymbols(tickers, src = "yahoo", from = start_date, to = end_date)
vbk.m.p = to.monthly(VBK$VBK.Adjusted, OHLC = FALSE)
vb.m.p  = to.monthly(VB$VB.Adjusted, OHLC = FALSE)
vbr.m.p = to.monthly(VBR$VBR.Adjusted, OHLC = FALSE)
vot.m.p = to.monthly(VOT$VOT.Adjusted, OHLC = FALSE)
vo.m.p  = to.monthly(VO$VO.Adjusted, OHLC = FALSE)
voe.m.p = to.monthly(VOE$VOE.Adjusted, OHLC = FALSE)
vug.m.p = to.monthly(VUG$VUG.Adjusted, OHLC = FALSE)
vv.m.p  = to.monthly(VV$VV.Adjusted, OHLC = FALSE)
vtv.m.p = to.monthly(VTV$VTV.Adjusted, OHLC = FALSE)
m.p <- merge(vbk.m.p, vb.m.p, vbr.m.p,
vot.m.p, vo.m.p, voe.m.p,
vug.m.p, vv.m.p, vtv.m.p)
colnames(m.p) <- c("VBK", "VB", "VBR",
"VOT", "VO", "VOE",
"VUG", "VV", "VTV")
m.lr.p = na.omit(diff(log(m.p)))*100
# sample mean
mean_vec_lr <- colMeans(m.lr.p)
mean_box_lr <- matrix(mean_vec_lr,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
mean_box_lr <- round(mean_box_lr, 3)
cat("\n3x3 Style Box: Mean Monthly Lor Return (%)\n")
mean_box_lr
var_vec_lr <- confint.lm(m.lr.p, 1, 0.95)
# Standard deviation of monthly log returns
sd_vec_lr <- apply(m.lr.p, 2, sd)
# 3x3 style box: SD of monthly log return (%)
sd_box_lr <- matrix(sd_vec_lr,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
sd_box_lr <- round(sd_box_lr, 3)
cat("\n3x3 Style Box: SD of Monthly Log Return (%)\n")
sd_box_lr
#========================================================
# BETA - Systematic Risk
#========================================================
# Need a market benchmark - use VV (Large Blend) or download SPY
library(quantmod)
getSymbols("SPY", src = "yahoo", from = "2015-12-01", to = "2025-12-31", periodicity = "monthly")
spy.p <- Ad(SPY)
spy.lr <- na.omit(diff(log(spy.p))) * 100
# Align dates with your ETF data
common_dates <- intersect(index(m.lr.p), index(spy.lr))
etf_aligned  <- m.lr.p[common_dates, ]
spy_aligned  <- spy.lr[common_dates]
# Calculate beta for each ETF vs SPY
beta_vec <- apply(etf_aligned, 2, function(etf) {
cov(etf, spy_aligned) / var(spy_aligned)
})
# 3x3 style box: Beta
beta_box <- matrix(beta_vec,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
# 3x3 style box: Beta
beta_box <- matrix(beta_vec,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
beta_box <- round(beta_box, 3)
beta_box <- matrix(beta_vec,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
confidence <- 0.95
var_vec <- apply(m.lr.p, 2, function(etf) {
-quantile(etf, probs = 1 - confidence)  # negative so VaR is expressed as a positive loss
})
# 3x3 style box: VaR
var_box <- matrix(var_vec,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
var_box <- round(var_box, 3)
cat("\n3x3 Style Box: Historical VaR 95% Monthly Log Return (%)\n")
var_box
library(quantmod)
#========================================================
# 1. Choose sample period
#========================================================
start_date <- "2015-12-01"
end_date   <- "2025-12-31"
#========================================================
# 2. Vanguard ETFs in the 3x3 style box
#    Order rows as: Small, Mid, Large
#========================================================
tickers <- c("VBK", "VB", "VBR",   # Small: growth, blend, value
"VOT", "VO", "VOE",   # Mid:   growth, blend, value
"VUG", "VV", "VTV")   # Large: growth, blend, value
#========================================================
# 3. Download ETF data from Yahoo Finance
#========================================================
getSymbols(tickers, src = "yahoo", from = start_date, to = end_date)
vbk.m.p = to.monthly(VBK$VBK.Adjusted, OHLC = FALSE)
vb.m.p  = to.monthly(VB$VB.Adjusted, OHLC = FALSE)
vbr.m.p = to.monthly(VBR$VBR.Adjusted, OHLC = FALSE)
vot.m.p = to.monthly(VOT$VOT.Adjusted, OHLC = FALSE)
vo.m.p  = to.monthly(VO$VO.Adjusted, OHLC = FALSE)
voe.m.p = to.monthly(VOE$VOE.Adjusted, OHLC = FALSE)
vug.m.p = to.monthly(VUG$VUG.Adjusted, OHLC = FALSE)
vv.m.p  = to.monthly(VV$VV.Adjusted, OHLC = FALSE)
vtv.m.p = to.monthly(VTV$VTV.Adjusted, OHLC = FALSE)
m.p <- merge(vbk.m.p, vb.m.p, vbr.m.p,
vot.m.p, vo.m.p, voe.m.p,
vug.m.p, vv.m.p, vtv.m.p)
colnames(m.p) <- c("VBK", "VB", "VBR",
"VOT", "VO", "VOE",
"VUG", "VV", "VTV")
# Log Returns
m.lr.p = na.omit(diff(log(m.p)))*100
# sample mean
mean_vec_lr <- colMeans(m.lr.p)
mean_box_lr <- matrix(mean_vec_lr,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
mean_box_lr <- round(mean_box_lr, 3)
cat("\n3x3 Style Box: Mean Monthly Lor Return (%)\n")
mean_box_lr
# Need a market benchmark - use VV (Large Blend) or download SPY
library(quantmod)
getSymbols("SPY", src = "yahoo", from = "2015-12-01", to = "2025-12-31", periodicity = "monthly")
spy.p <- Ad(SPY)
spy.lr <- na.omit(diff(log(spy.p))) * 100
# Align dates with your ETF data
common_dates <- intersect(index(m.lr.p), index(spy.lr))
etf_aligned  <- m.lr.p[common_dates, ]
spy_aligned  <- spy.lr[common_dates]
# Calculate beta for each ETF vs SPY
beta_vec <- apply(etf_aligned, 2, function(etf) {
cov(etf, spy_aligned) / var(spy_aligned)
})
# 3x3 style box: Beta
beta_box <- matrix(beta_vec,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
# Calculate beta for each ETF vs SPY
beta_vec <- apply(etf_aligned, 2, function(etf) {
cov(etf, spy_aligned) / var(spy_aligned)
})
# Check you have exactly 9 values
print(length(beta_vec))
print(beta_vec)
# 3x3 style box: Beta
beta_box <- matrix(as.numeric(beta_vec),   # as.numeric() strips any names/attributes
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
print(class(index(m.lr.p)))
print(head(index(m.lr.p)))
print(class(index(spy.lr)))
print(head(index(spy.lr)))
# Check dimensions before alignment
print(dim(m.lr.p))
print(length(spy.lr))
library(zoo)
index(spy.lr) <- as.yearmon(index(spy.lr))
# Now align
common_dates <- intersect(index(m.lr.p), index(spy.lr))
etf_aligned  <- m.lr.p[common_dates, ]
spy_aligned  <- spy.lr[common_dates]
# Check alignment worked
print(length(common_dates))  # should be 120
print(dim(etf_aligned))      # should be 120 x 9
# Now calculate beta
beta_vec <- apply(etf_aligned, 2, function(etf) {
cov(etf, spy_aligned) / var(spy_aligned)
})
print(length(beta_vec))  # should be 9
print(beta_vec)
# 3x3 style box: Beta
beta_box <- matrix(as.numeric(beta_vec),
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
beta_box <- round(beta_box, 3)
cat("\n3x3 Style Box: Beta (vs SPY)\n")
beta_box
#========================================================
# VALUE AT RISK (VaR) - Historical Method
#========================================================
# 95% confidence level, 1-month horizon
confidence <- 0.95
var_vec <- apply(m.lr.p, 2, function(etf) {
-quantile(etf, probs = 1 - confidence)  # negative so VaR is expressed as a positive loss
})
# 3x3 style box: VaR
var_box <- matrix(var_vec,
nrow = 3, byrow = TRUE,
dimnames = list(c("Small", "Mid", "Large"),
c("Growth", "Blend", "Value")))
var_box <- round(var_box, 3)
cat("\n3x3 Style Box: Historical VaR 95% Monthly Log Return (%)\n")
var_box
var_box
mean_box_lr
